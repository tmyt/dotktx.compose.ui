<Project Sdk="DotKt.Sdk.Mpp">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>DotKtX.Compose.UI.AppKit</AssemblyName>
    <PackageId>DotKtX.Compose.UI.AppKit</PackageId>
    <IsPackable>true</IsPackable>
    <Version>$(DotKtXComposeUIVersion)</Version>
    <Authors>yutaka</Authors>
    <Description>AppKit (macOS) for the Compose runtime on DotKt: application and windows, controls, layouts, menus and ComposeHost over native AppKit views.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>$(DotKtXAppKitTargetFramework)</TargetFramework>
    <DotKtKotcOptions>-opt-in=kotlinx.coroutines.ExperimentalCoroutinesApi</DotKtKotcOptions>
  </PropertyGroup>
  <!-- The package applies this through buildTransitive; the project itself has to import it. -->
  <Import Project="buildTransitive/DotKtX.Compose.UI.AppKit.props" />
  <ItemGroup>
    <KotlinCompile Include="**/*.kt" />
  </ItemGroup>
  <Import Project="$(DotKtXComposeRepo)eng/ComposeCompilerPlugin.targets" />
  <Import Project="../../../eng/Analyzers.targets" />
  <ItemGroup>
    <ProjectReference Include="../../../annotations/src/DotKtX.Compose.UI.Annotations/DotKtX.Compose.UI.Annotations.ktproj" />
    <!-- Becomes a package dependency, so applications get the diagnostics without further setup. -->
    <ProjectReference Include="../../../analyzers/DotKtX.Compose.UI.Analyzers.proj" />
    <ProjectReference Include="$(DotKtXComposeRepo)src/Runtime/Runtime.ktproj" />
    <PackageReference Include="DotKtX.Coroutines" Version="$(DotKtXCoroutinesVersion)" />
    <PackageReference Include="DotKtX.AtomicFU" Version="$(DotKtXAtomicFUVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/DotKtX.Compose.UI.AppKit.props" Pack="true" PackagePath="buildTransitive/DotKtX.Compose.UI.AppKit.props" />
    <None Include="buildTransitive/DotKtX.Compose.UI.AppKit.Language.targets" Pack="true" PackagePath="buildTransitive/DotKtX.Compose.UI.AppKit.Language.targets" />
  </ItemGroup>
</Project>

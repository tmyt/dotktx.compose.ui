<Project Sdk="DotKt.Sdk.Mpp">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DotKtXAppKitTargetFramework)</TargetFramework>
    <ApplicationId>dev.dotktx.compose.smoke</ApplicationId>
    <RuntimeIdentifier>$(DotKtXAppKitRuntimeIdentifier)</RuntimeIdentifier>
    <StartupObject>SmokeKt</StartupObject>
  </PropertyGroup>
  <!-- The package applies this through buildTransitive; a ProjectReference has to import it. -->
  <Import Project="../../src/DotKtX.Compose.UI.AppKit/buildTransitive/DotKtX.Compose.UI.AppKit.props" />
  <Import Project="$(DotKtXComposeRepo)eng/ComposeCompilerPlugin.targets" />
  <ItemGroup>
    <ProjectReference Include="../../src/DotKtX.Compose.UI.AppKit/DotKtX.Compose.UI.AppKit.ktproj" />
  </ItemGroup>
</Project>

<Project Sdk="DotKt.Sdk.Mpp">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>DotKtX.Compose.UI.WinUI</AssemblyName>
    <PackageId>DotKtX.Compose.UI.WinUI</PackageId>
    <IsPackable>true</IsPackable>
    <Version>$(DotKtXComposeUIVersion)</Version>
    <Authors>yutaka</Authors>
    <Description>WinUI 3 for the Compose runtime on DotKt: application and windows, controls, layouts, navigation, menus, dialogs, lazy lists and ComposeHost over native WinUI elements.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>$(DotKtXWinUITargetFramework)</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <!-- Allows compiling the windows TFM on Linux; running needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- A code-only library has no resources; do not pack a PRI when generation is disabled. -->
    <IncludeProjectPriFile Condition="'$(AppxGeneratePriEnabled)' == 'false'">false</IncludeProjectPriFile>
    <DotKtKotcOptions>-opt-in=kotlinx.coroutines.ExperimentalCoroutinesApi</DotKtKotcOptions>
  </PropertyGroup>
  <ItemGroup>
    <KotlinCompile Include="**/*.kt" />
  </ItemGroup>
  <Import Project="$(DotKtXComposeRepo)eng/ComposeCompilerPlugin.targets" />
  <Import Project="../../../eng/Analyzers.targets" />
  <ItemGroup>
    <ProjectReference Include="../../../annotations/src/DotKtX.Compose.UI.Annotations/DotKtX.Compose.UI.Annotations.ktproj" />
    <!-- Becomes a package dependency, so applications get the diagnostics without further setup. -->
    <ProjectReference Include="../../../analyzers/DotKtX.Compose.UI.Analyzers.proj" />
    <ProjectReference Include="$(DotKtXComposeRepo)src/Runtime/Runtime.ktproj" />
    <PackageReference Include="DotKtX.Coroutines" Version="$(DotKtXCoroutinesVersion)" />
    <PackageReference Include="DotKtX.AtomicFU" Version="$(DotKtXAtomicFUVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(DotKtXWindowsAppSDKVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/DotKtX.Compose.UI.WinUI.targets" Pack="true" PackagePath="buildTransitive/DotKtX.Compose.UI.WinUI.targets" />
    <None Include="buildTransitive/DotKtX.Compose.UI.WinUI.manifest" Pack="true" PackagePath="buildTransitive/DotKtX.Compose.UI.WinUI.manifest" />
  </ItemGroup>
</Project>

<Project Sdk="DotKt.Sdk.Mpp">
  <!-- The counter sample built against the packages instead of the source projects. The application
       manifest, the Windows App SDK version and the Compose compiler plugin must all come from the
       packages' buildTransitive targets, so nothing is imported here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DotKtXWinUITargetFramework)</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <StartupObject>CounterKt</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <KotlinCompile Include="../../samples/counter/Counter.kt" />
    <PackageReference Include="DotKtX.Compose.UI.WinUI" Version="[$(DotKtXComposeUIVersion)]" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(DotKtXWindowsAppSDKVersion)" />
  </ItemGroup>
</Project>

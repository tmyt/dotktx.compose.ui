<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="release" value="../../../artifacts/packages" />
    <add key="compose" value="../../../../dotktx.compose/artifacts/packages" />
    <add key="dotkt-remote" value="https://dotkt.utatane.dev/nuget/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="release">
      <package pattern="DotKtX.Compose.UI.*" />
    </packageSource>
    <packageSource key="compose">
      <package pattern="DotKtX.AndroidX.*" />
    </packageSource>
    <packageSource key="dotkt-remote">
      <package pattern="DotKt.*" />
      <package pattern="DotKtX.AtomicFU" />
      <package pattern="DotKtX.Coroutines" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

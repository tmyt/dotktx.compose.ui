<Project Sdk="DotKt.Sdk.Mpp">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DotKtXWinUITargetFramework)</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Allows compiling the windows TFM on Linux; running needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- A Windows apphost (<name>.exe) carries the application manifest; started as `dotnet <name>.dll`,
         the process would use dotnet.exe's manifest and run DPI-unaware. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <StartupObject>CommandsKt</StartupObject>
  </PropertyGroup>
  <Import Project="$(DotKtXComposeRepo)eng/ComposeCompilerPlugin.targets" />
  <Import Project="../../../eng/Analyzers.targets" />
  <!-- The package applies this through buildTransitive; a ProjectReference has to import it. -->
  <Import Project="../../src/DotKtX.Compose.UI.WinUI/buildTransitive/DotKtX.Compose.UI.WinUI.targets" />
  <ItemGroup>
    <ProjectReference Include="../../src/DotKtX.Compose.UI.WinUI/DotKtX.Compose.UI.WinUI.ktproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(DotKtXWindowsAppSDKVersion)" />
  </ItemGroup>
</Project>

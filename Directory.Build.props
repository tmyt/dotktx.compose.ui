<Project>
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Include the relative project directory so identically named projects of different backends stay apart. -->
    <_DotKtXProjectPath>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</_DotKtXProjectPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/bin/$(_DotKtXProjectPath)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/$(_DotKtXProjectPath)/</BaseIntermediateOutputPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>

    <!-- The Compose runtime sources and build helpers come from the sibling dotktx.compose checkout. -->
    <DotKtXComposeRepo>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../dotktx.compose/'))</DotKtXComposeRepo>

    <DotKtXWinUITargetFramework>net10.0-windows10.0.19041.0</DotKtXWinUITargetFramework>
    <!-- The Windows SDK projection (and with it WinRT.Runtime) otherwise follows the .NET SDK doing the
         build: .NET SDK 11 picks 10.0.19041.87 (WinRT.Runtime 2.3.1.0), .NET SDK 10 picks 10.0.19041.57
         (WinRT.Runtime 2.2.0.0). The library is compiled against the oldest one, so applications built
         with either .NET SDK provide the WinRT.Runtime version it references or a newer one. -->
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <DotKtXWindowsAppSDKVersion>2.2.0</DotKtXWindowsAppSDKVersion>
    <!-- macOS: the SDK pack for platform version 26.0 is pinned; Xcode only has to be at least that version.
         The Apple SDK's exact Xcode-version check is disabled for that reason (it fails with any newer Xcode). -->
    <DotKtXAppKitTargetFramework>net10.0-macos26.0</DotKtXAppKitTargetFramework>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <!-- Without a RuntimeIdentifier, a Release build makes a universal (arm64 + x64) bundle whose lipo-merged
         libraries fail code-signature validation at launch; applications build for the machine's architecture. -->
    <_DotKtXHostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_DotKtXHostArchitecture>
    <DotKtXAppKitRuntimeIdentifier>osx-$(_DotKtXHostArchitecture)</DotKtXAppKitRuntimeIdentifier>
    <DotKtXComposeUIVersion>0.3.2</DotKtXComposeUIVersion>
    <DotKtXAtomicFUVersion>[0.9.16]</DotKtXAtomicFUVersion>
    <DotKtXCoroutinesVersion>[0.9.15]</DotKtXCoroutinesVersion>
  </PropertyGroup>
</Project>
